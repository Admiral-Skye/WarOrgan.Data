@page "/"
@using WarOrgan.Model.DataSet;
@using WarOrgan.Data.Common.Utils;
@using WarOrgan.Data.Common.Validation;


@{ 

string? defaultDatasetId = "Warhammer40k11e";
Version? defaultVersion = new Version(major: 1, minor: 0, build: 0, revision: 5);
string? defaultBuildDirectory = AppContext.BaseDirectory;

DataSetInfo? datasetInfo = new DataSetInfo(
    Id: defaultDatasetId,
    Version: defaultVersion,
    DataSetFormatVersion: DataSetInfo.CurrentDataSetFormatVersion,
    PublishDate: DateTime.UtcNow);

// Setup paths
string? assetsFolder = Path.Combine(AppContext.BaseDirectory, "Assets", defaultDatasetId).EnsureDirectoryExists();
string? outputFolder = Path.Combine(AppContext.BaseDirectory, "Output").EnsureDirectoryExists();
string? rostersFolder = Path.Combine(assetsFolder, "Rosters").EnsureDirectoryExists();

}

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<p>@assetsFolder</p>
<p>@outputFolder</p>
<p>@rostersFolder</p>